// MusicVerse database schema — Phase 1 (identity, access control, audit).
// Later domains are designed in documentation/database/erd.md and added in their phases.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  pending_deletion
  deleted

  @@map("user_status")
}

enum ClientType {
  web
  mobile
  admin

  @@map("client_type")
}

enum VerificationTokenType {
  email_verification
  password_reset

  @@map("verification_token_type")
}

enum OAuthProvider {
  google
  apple

  @@map("oauth_provider")
}

enum MfaFactorType {
  totp

  @@map("mfa_factor_type")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased and trimmed.
  email           String     @unique @db.VarChar(254)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// argon2id hash; null for social-only accounts.
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(active)
  suspendedReason String?    @map("suspended_reason") @db.VarChar(500)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile            UserProfile?
  roles              UserRole[]           @relation("UserRoles")
  grantedRoles       UserRole[]           @relation("RoleGrantedBy")
  sessions           Session[]
  verificationTokens VerificationToken[]
  oauthAccounts      OAuthAccount[]
  mfaFactors         MfaFactor[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(80)
  username    String?  @unique @db.VarChar(30)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(2048)
  bio         String?  @db.VarChar(500)
  countryCode String?  @map("country_code") @db.Char(2)
  locale      String   @default("en") @db.VarChar(10)
  /// Validated by @musicverse/validation (theme, explicitContent, emailNotifications).
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique @db.VarChar(50)
  name             String   @db.VarChar(100)
  description      String   @db.VarChar(500)
  isStaff          Boolean  @default(false) @map("is_staff")
  isSelfAssignable Boolean  @default(false) @map("is_self_assignable")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  description String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  /// SHA-256 of the current refresh token. Rotated on every refresh.
  refreshTokenHash String     @unique @map("refresh_token_hash") @db.Char(64)
  /// SHA-256 of the immediately previous refresh token, kept to detect reuse.
  previousTokenHash String?   @unique @map("previous_token_hash") @db.Char(64)
  clientType       ClientType @map("client_type")
  userAgent        String?    @map("user_agent") @db.VarChar(512)
  /// Truncated (/24 IPv4, /48 IPv6) for privacy.
  ipAddress        String?    @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?    @map("revoked_reason") @db.VarChar(50)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?             @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  email             String?       @db.VarChar(254)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model MfaFactor {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            MfaFactorType
  /// AES-256-GCM encrypted secret: base64(iv | tag | ciphertext), prefixed with key version.
  secretEncrypted String        @map("secret_encrypted") @db.VarChar(512)
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; codes for this step or earlier are rejected (replay protection).
  lastUsedStep    BigInt?       @map("last_used_step")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

/// Append-only. The application never updates or deletes audit rows.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  requestId  String?  @map("request_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
