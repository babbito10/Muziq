# =============================================================================
# MusicVerse environment configuration — EXAMPLE VALUES ONLY.
# Copy the relevant section to apps/<app>/.env for local development.
# Never commit real secrets. In Google Cloud, secrets come from Secret Manager.
# =============================================================================

# ---------------------------------------------------------------- API (apps/api/.env)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public URL of the web app — used to build links in emails.
WEB_APP_URL=http://localhost:3000
# Comma-separated origins allowed by CORS (web + admin when not using the same-origin rewrite).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of proxy hops to trust for client IPs (1 behind Cloud Run / a load balancer).
TRUST_PROXY=0
SWAGGER_ENABLED=true

DATABASE_URL=postgresql://musicverse:musicverse@localhost:5432/musicverse?schema=public
# Used by the API integration tests (schema is reset on every run).
TEST_DATABASE_URL=postgresql://musicverse:musicverse@localhost:5432/musicverse_test?schema=public
REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 random bytes, base64. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64==========
# false only for plain-http local development.
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# Email. `console` is a DEVELOPMENT-ONLY transport that logs emails instead of sending them;
# it is rejected when NODE_ENV=production. Use `smtp` with a real provider in staging/production.
MAIL_TRANSPORT=console
MAIL_FROM="MusicVerse <no-reply@musicverse.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Social sign-in. Leave empty to disable (endpoints return 503 PROVIDER_NOT_CONFIGURED).
# Comma-separated OAuth client IDs accepted as the ID-token audience (web, iOS, Android).
GOOGLE_CLIENT_IDS=
# Comma-separated Apple Services ID / bundle IDs accepted as the ID-token audience.
APPLE_CLIENT_IDS=

# Seed: optional first super administrator (created only if both are set).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Web & Admin (apps/web/.env, apps/admin/.env)
# Public API base URL, read at request time. Browsers call it directly, so the web/admin origin must
# be listed in the API's CORS_ORIGINS and the two must be same-site (e.g. app.example / api.example).
PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------- Mobile (apps/mobile/.env)
# Must be reachable from the device/emulator (use your LAN IP, not localhost, on a phone).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
